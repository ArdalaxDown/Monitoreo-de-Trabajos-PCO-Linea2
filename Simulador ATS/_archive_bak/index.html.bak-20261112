        <!-- Capa de Señales ATS Clicables -->
        <g id="signals-layer">
          <g class="signal-group" id="sig-s20-2" transform="translate(600, 200)" title="Señal S20-2">
            <line x1="0" y1="0" x2="0" y2="20" class="signal-post" />
            <circle cx="0" cy="0" r="5" class="signal-lamp lamp-green" />
            <text x="0" y="-8" fill="#94a3b8" font-size="7.5" font-family="monospace" text-anchor="middle">S20-2</text>
          </g>
          <g class="signal-group" id="sig-s20-1" transform="translate(600, 340)" title="Señal S20-1">
            <line x1="0" y1="0" x2="0" y2="20" class="signal-post" />
            <circle cx="0" cy="20" r="5" class="signal-lamp lamp-green" />
            <text x="0" y="32" fill="#94a3b8" font-size="7.5" font-family="monospace" text-anchor="middle">S20-1</text>
          </g>
          <g class="signal-group" id="sig-s21-2e" transform="translate(1100, 200)" title="Señal S21-2E">
            <circle cx="0" cy="0" r="5" class="signal-lamp lamp-green" />
            <text x="0" y="-8" fill="#94a3b8" font-size="7.5" font-family="monospace" text-anchor="middle">S21-2E</text>
