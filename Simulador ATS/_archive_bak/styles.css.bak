/* ==========================================================================
   SIMULADOR ATS - MONITOREO DE TRABAJOS EN VÍA PRINCIPAL (OCIR LÍNEA 2)
   Estilo HMI Hitachi Rail STS - Paleta Amigable, Alta Legibilidad & Cero Flickering
   ========================================================================== */

:root {
  /* Fondo amigable: Azul pizarra profundo descansado */
  --bg-app: #0b111e;
  --bg-panel: #10192a;
  --bg-card: #162238;
  --bg-elevated: #1e2e4a;
  --border-subtle: #273b5c;
  --border-accent: #38bdf8;
  
  --text-main: #f1f5f9;
  --text-muted: #94a3b8;
  --text-bright: #ffffff;
  
  /* Estados de Vía Amigables y de Alto Contraste */
  --via-nominal: #64748b;        /* Riel de acero visible */
  --via-ocupada: #0284c7;        /* Vehículo auxiliar: Azul cian corporativo */
  --via-mantenimiento: #f59e0b;  /* Personal a pie: Ámbar cálido visible */
  --via-exclusion: #a855f7;      /* Exclusión técnica: Púrpura */
  --via-prohibido: #ef4444;      /* Prohibido / Conflicto: Rojo alerta */
  
  /* Colores de Estaciones y Señales (Alta Legibilidad) */
  --station-badge-bg: #0284c7;
  --station-box-bg: #142238;
  --station-box-border: #38bdf8;
  --accent-cyan: #38bdf8;
  --accent-amber: #fbbf24;
  --accent-green: #10b981;
  --accent-red: #ef4444;
  
  /* Curvas Calibradas de Animación */
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --ease-elastic: cubic-bezier(0.34, 1.56, 0.64, 1);
  
  --shadow-panel: 0 8px 30px rgba(0, 0, 0, 0.5);
  --shadow-glow-cyan: 0 0 18px rgba(56, 189, 248, 0.45);
  --shadow-glow-amber: 0 0 18px rgba(245, 158, 11, 0.45);
  --shadow-glow-danger: 0 0 25px rgba(239, 68, 68, 0.85);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background-color: var(--bg-app);
  color: var(--text-main);
  height: 100vh;
  width: 100vw;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  user-select: none;
}

/* ==========================================================================
   1. CABECERA PRINCIPAL (HEADER)
   ========================================================================== */
#sys-header {
  height: 52px;
  background: linear-gradient(180deg, #131e33 0%, #0d1524 100%);
  border-bottom: 2px solid var(--border-accent);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  z-index: 100;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
}

.brand-section {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-badge {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #fff;
  font-weight: 900;
  font-size: 11px;
  padding: 4px 9px;
  border-radius: 4px;
  letter-spacing: 1px;
  box-shadow: 0 2px 8px rgba(2, 132, 199, 0.4);
}

.brand-title {
  display: flex;
  flex-direction: column;
}

.brand-title h1 {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1.2px;
  color: #fff;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}

.brand-title span {
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 0.8px;
}

.header-telemetry {
  display: flex;
  align-items: center;
  gap: 10px;
}

.telemetry-card {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.04);
  padding: 5px 12px;
  border-radius: 6px;
  border: 1px solid var(--border-subtle);
  transition: all 0.2s var(--ease-out);
}

.telemetry-card:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--accent-cyan);
}

.telemetry-card .card-icon {
  font-size: 15px;
}

.telemetry-card .card-info {
  display: flex;
  flex-direction: column;
}

.telemetry-card .card-info label {
  font-size: 9px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.telemetry-card .card-info strong {
  font-size: 13px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  color: var(--accent-cyan);
}

.sound-toggle-btn {
  background: #101c30;
  border: 1px solid var(--border-subtle);
  color: #94a3b8;
  padding: 5px 10px;
  border-radius: 5px;
  font-size: 11px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: all 0.15s;
}

.sound-toggle-btn.sound-on {
  color: #38bdf8;
  border-color: rgba(56, 189, 248, 0.5);
  box-shadow: 0 0 8px rgba(56, 189, 248, 0.25);
}

#clock-display {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 15px;
  font-weight: 700;
  color: #38bdf8;
  background: #080f1a;
  padding: 5px 12px;
  border-radius: 5px;
  border: 1px solid #1e3a5f;
  letter-spacing: 1.2px;
}

/* ==========================================================================
   2. BARRA DE NAVEGACIÓN RÁPIDA (STATION QUICK-JUMP)
   ========================================================================== */
#station-quicknav {
  height: 36px;
  background: #0d1524;
  border-bottom: 1px solid #1a2942;
  display: flex;
  align-items: center;
  padding: 0 16px;
  gap: 8px;
  overflow-x: auto;
  z-index: 95;
}

.quicknav-title {
  font-size: 9.5px;
  font-weight: 800;
  text-transform: uppercase;
  color: #94a3b8;
  letter-spacing: 1px;
  margin-right: 4px;
  white-space: nowrap;
}

.nav-pill {
  background: #142034;
  border: 1px solid #283e60;
  color: #cbd5e1;
  padding: 4px 11px;
  border-radius: 4px;
  font-size: 10.5px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: all 0.15s var(--ease-out);
}

.nav-pill:hover {
  background: #1e3252;
  color: #fff;
  border-color: var(--accent-cyan);
  transform: translateY(-1px);
}

.nav-pill:active {
  transform: scale(0.96);
}

.nav-pill.station {
  border-left: 3.5px solid #0284c7;
}

.nav-pill.pozo {
  border-left: 3.5px solid #f59e0b;
  color: #fde68a;
}

.nav-pill.ptsa {
  border-left: 3.5px solid #10b981;
}

/* ==========================================================================
   3. BANDEJA DE FICHAS TIPO GOOGLE MAPS / PEGMAN
   ========================================================================== */
#monopoly-toolbar {
  height: 66px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  z-index: 90;
}

.toolbar-group {
  display: flex;
  align-items: center;
  gap: 12px;
}

.toolbar-label {
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  color: #94a3b8;
  letter-spacing: 1.2px;
}

/* Fichas Estilo Pegman */
.pegman-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 15px;
  border-radius: 8px;
  background: linear-gradient(180deg, #1b283f 0%, #131e31 100%);
  border: 1.5px solid #2e4468;
  cursor: grab;
  position: relative;
  transition: transform 0.18s var(--ease-elastic), border-color 0.18s, box-shadow 0.18s;
}

.pegman-chip:hover {
  transform: translateY(-2px) scale(1.02);
  border-color: var(--accent-cyan);
  box-shadow: 0 8px 22px rgba(56, 189, 248, 0.3);
}

.pegman-chip:active {
  cursor: grabbing;
  transform: scale(0.96);
}

.pegman-chip.chip-crew {
  border-left: 4px solid var(--accent-amber);
}

.pegman-chip.chip-crew:hover {
  border-color: var(--accent-amber);
  box-shadow: 0 8px 22px rgba(245, 158, 11, 0.35);
}

.pegman-chip.chip-vehicle {
  border-left: 4px solid var(--accent-cyan);
}

.pegman-icon-box {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  background: rgba(255, 255, 255, 0.06);
}

.pegman-chip.chip-crew .pegman-icon-box {
  background: rgba(245, 158, 11, 0.2);
  color: var(--accent-amber);
}

.pegman-chip.chip-vehicle .pegman-icon-box {
  background: rgba(56, 189, 248, 0.2);
  color: var(--accent-cyan);
}

.pegman-text {
  display: flex;
  flex-direction: column;
}

.pegman-text strong {
  font-size: 12px;
  font-weight: 800;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 6px;
}

.pegman-text span {
  font-size: 10px;
  color: #94a3b8;
}

.drag-hint-badge {
  background: rgba(56, 189, 248, 0.2);
  color: #38bdf8;
  font-size: 8.5px;
  font-weight: 800;
  padding: 2px 6px;
  border-radius: 3px;
  text-transform: uppercase;
}

/* Botones Auxiliares */
.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  color: var(--text-main);
  cursor: pointer;
  transition: all 0.15s var(--ease-out);
}

.action-btn:hover {
  background: var(--bg-elevated);
  border-color: var(--border-accent);
  color: #fff;
  transform: translateY(-1px);
}

.action-btn:active {
  transform: scale(0.96);
}

.action-btn.btn-pitch {
  background: linear-gradient(135deg, #16304a 0%, #0d1e30 100%);
  border-color: #38bdf8;
  color: #38bdf8;
}

.action-btn.btn-pitch:hover {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #fff;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
}

/* ==========================================================================
   4. ELEMENTOS FLOTANTES DE ARRASTRE Y SEGURIDAD
   ========================================================================== */

#pegman-drag-ghost {
  position: fixed;
  top: 0;
  left: 0;
  pointer-events: none;
  z-index: 5000;
  transform: translate(-50%, -85%);
  display: none;
  filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.8));
}

#pegman-drag-ghost .ghost-inner {
  font-size: 40px;
  animation: pegmanDangle 0.5s infinite alternate ease-in-out;
  transform-origin: center top;
}

@keyframes pegmanDangle {
  0% { transform: rotate(-8deg) scale(1.05); }
  100% { transform: rotate(8deg) scale(1.05); }
}

.ghost-via-badge {
  font-size: 10px;
  font-weight: 800;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  padding: 3px 8px;
  border-radius: 4px;
  margin-top: 2px;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5px;
}

.ghost-via-badge.via-v1 {
  background: #064e3b;
  color: #a7f3d0;
  border: 1px solid #10b981;
}

.ghost-via-badge.via-v2 {
  background: #1e3a8a;
  color: #bfdbfe;
  border: 1px solid #38bdf8;
}

.ghost-via-badge.via-forbidden {
  background: #991b1b;
  color: #fee2e2;
  border: 1px solid #ef4444;
  animation: pulseForbiddenBadge 0.35s infinite alternate;
}

@keyframes pulseForbiddenBadge {
  0% { transform: scale(1); }
  100% { transform: scale(1.06); filter: brightness(1.2); }
}

/* BANNER FLOTANTE DE ADVERTENCIA CRÍTICA: PROHIBIDO */
#prohibition-hud {
  position: fixed;
  z-index: 5500;
  pointer-events: none;
  background: linear-gradient(180deg, #dc2626 0%, #991b1b 100%);
  border: 2px solid #f87171;
  border-radius: 8px;
  padding: 10px 16px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.9), var(--shadow-glow-danger);
  color: #fff;
  display: none;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  transform: translate(-50%, -130%);
  animation: prohibitionStrobe 0.4s infinite alternate;
}

@keyframes prohibitionStrobe {
  0% { transform: translate(-50%, -130%) scale(1); filter: brightness(1); }
  100% { transform: translate(-50%, -130%) scale(1.04); filter: brightness(1.2); }
}

.prohibition-title {
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 6px;
  text-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
}

.prohibition-desc {
  font-size: 10.5px;
  font-weight: 600;
  color: #fee2e2;
  text-align: center;
  max-width: 290px;
}

/* ==========================================================================
   5. ÁREA PRINCIPAL: LIENZO SVG DE VÍA PRINCIPAL
   ========================================================================== */
#main-viewport {
  flex: 1;
  position: relative;
  background: radial-gradient(circle at 50% 50%, #0e1726 0%, #090e18 100%);
  overflow: hidden;
}

#svg-pan-zoom-container {
  width: 100%;
  height: 100%;
  cursor: grab;
}

#svg-pan-zoom-container:active {
  cursor: grabbing;
}

#track-svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* Líneas de Vía ATS */
.svg-track-line {
  stroke: var(--via-nominal);
  stroke-width: 6.5px;
  stroke-linecap: round;
  transition: stroke 0.25s, filter 0.25s;
}

.svg-track-zone {
  cursor: pointer;
}

.svg-track-zone:hover .svg-track-line {
  stroke: #94a3b8;
  filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.5));
}

/* Zona iluminada por Magnetismo durante Drag */
.zone-hover-active .svg-track-line {
  stroke: #38bdf8 !important;
  filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.85)) !important;
}

/* Zona en Conflicto Prohibido */
.zone-forbidden .svg-track-line {
  stroke: var(--via-prohibido) !important;
  stroke-dasharray: 8 4 !important;
  filter: drop-shadow(0 0 14px rgba(239, 68, 68, 0.95)) !important;
}

/* Ondulación de Colocación (Placement Ripple) */
.placement-ripple {
  animation: rippleSpread 1.2s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
}

@keyframes rippleSpread {
  0% { r: 5px; opacity: 1; stroke-width: 4px; }
  100% { r: 60px; opacity: 0; stroke-width: 1px; }
}

/* ==========================================================================
   ESTACIONES Y ANDENES: NUEVA PALETA AMIGABLE Y ALTO CONTRASTE
   ========================================================================== */
.station-group {
  cursor: pointer;
}

/* Insignia Principal de Estación */
.station-pill-badge {
  fill: #0284c7;
  stroke: #38bdf8;
  stroke-width: 1.5px;
  rx: 15px;
  filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.4));
  transition: all 0.2s var(--ease-out);
}

.station-group:hover .station-pill-badge {
  fill: #0369a1;
  stroke: #7dd3fc;
  filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.6));
}

.station-pill-text {
  fill: #ffffff;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.8px;
  text-anchor: middle;
}

/* Andenes (Plataformas) de Estación */
.platform-box {
  fill: #142238;
  stroke: #2b456b;
  stroke-width: 1.5px;
  rx: 6px;
  transition: all 0.2s var(--ease-out);
}

.station-group:hover .platform-box {
  fill: #1c304f;
  stroke: var(--accent-cyan);
  filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.4));
}

.platform-text {
  fill: #f8fafc;
  font-size: 11.5px;
  font-weight: 800;
  text-anchor: middle;
  letter-spacing: 0.8px;
}

/* Pozos de Ventilación (PV) - Alta Visibilidad y Espaciado Generoso */
.pozo-group {
  cursor: pointer;
}

.pozo-tower {
  fill: #1b263b;
  stroke: #f59e0b;
  stroke-width: 1.5px;
  rx: 5px;
  transition: all 0.2s;
}

.pozo-group:hover .pozo-tower {
  fill: #2d3e5e;
  filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.6));
}

.pozo-label {
  fill: #fde68a;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 900;
  text-anchor: middle;
}

/* Cambiavías / Bretelles */
.switch-group {
  cursor: pointer;
}

.crossover-line {
  stroke: #5a738e;
  stroke-width: 4.5px;
  stroke-linecap: round;
  transition: stroke 0.25s, filter 0.25s;
}

.switch-group:hover .crossover-line {
  stroke: var(--accent-cyan);
  filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.6));
}

.switch-group.switch-diverted .crossover-line {
  stroke: var(--accent-amber);
  filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.7));
}

.switch-point {
  fill: #829ab1;
  transition: fill 0.2s;
}

.switch-group:hover .switch-point {
  fill: #38bdf8;
}

/* Señales ATS */
.signal-group {
  cursor: pointer;
}

.signal-post {
  stroke: #5a738e;
  stroke-width: 2px;
}

.signal-head {
  fill: #080f1a;
  stroke: #2e4468;
  stroke-width: 1px;
}

.signal-lamp {
  transition: fill 0.2s, filter 0.2s;
}

.signal-lamp.lamp-green {
  fill: #10b981;
  filter: drop-shadow(0 0 6px #10b981);
}

.signal-lamp.lamp-red {
  fill: #ef4444;
  filter: drop-shadow(0 0 6px #ef4444);
}

.signal-lamp.lamp-amber {
  fill: #f59e0b;
  filter: drop-shadow(0 0 6px #f59e0b);
}

/* Controles de Vista Flotantes */
#viewport-controls {
  position: absolute;
  bottom: 20px;
  right: 20px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  z-index: 80;
  background: rgba(16, 25, 42, 0.85);
  backdrop-filter: blur(10px);
  padding: 6px;
  border-radius: 8px;
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-panel);
}

.vp-control-btn {
  width: 34px;
  height: 34px;
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  color: #fff;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}

.vp-control-btn:hover {
  background: var(--bg-elevated);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
}

.vp-control-btn:active {
  transform: scale(0.92);
}

/* ==========================================================================
   6. ENTIDADES ESTÁTICAS DE TRABAJO (CERO PARPADEO)
   ========================================================================== */

/* Cuadrilla a pie (Estática en vía) */
.crew-token {
  cursor: pointer;
  transition: filter 0.15s;
}

.crew-token:hover {
  filter: drop-shadow(0 0 14px rgba(245, 158, 11, 0.95));
}

/* Vehículo Auxiliar (Estático en vía) */
.vehicle-token {
  cursor: pointer;
  transition: filter 0.15s;
}

.vehicle-token:hover {
  filter: drop-shadow(0 0 16px rgba(56, 189, 248, 0.95));
}

.vehicle-hazard-beacon {
  animation: hazardStrobe 0.7s infinite alternate ease-in-out;
}

@keyframes hazardStrobe {
  0% { r: 2.2px; fill: #fde68a; filter: drop-shadow(0 0 2px #fde68a); }
  100% { r: 4px; fill: #f59e0b; filter: drop-shadow(0 0 8px #f59e0b); }
}

/* Badge de Múltiples Cuadrillas Coexistiendo */
.multicrew-badge {
  cursor: pointer;
  transition: transform 0.15s;
}

.multicrew-badge:hover rect {
  fill: #0369a1;
  stroke: #7dd3fc;
}

/* ==========================================================================
   7. TARJETA FLOTANTE DE EDICIÓN RÁPIDA (FIJA EN PANTALLA - ALTA VISIBILIDAD)
   ========================================================================== */
#token-quickcard {
  position: fixed !important;
  z-index: 99999 !important;
  background: #111e33;
  border: 2px solid var(--accent-cyan);
  border-radius: 10px;
  padding: 16px 20px;
  min-width: 320px;
  max-width: 420px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 25px rgba(56, 189, 248, 0.35);
  display: none;
  flex-direction: column;
  gap: 10px;
  backdrop-filter: blur(12px);
  animation: cardFadeIn 0.18s var(--ease-elastic);
}

@keyframes cardFadeIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}

#token-quickcard h4 {
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1.5px solid rgba(56, 189, 248, 0.25);
  padding-bottom: 8px;
}

.quickcard-field {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.quickcard-field label {
  font-size: 9.5px;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.quickcard-field input, .quickcard-field select {
  background: #09111c;
  border: 1px solid var(--border-subtle);
  color: #fff;
  padding: 6px 8px;
  border-radius: 4px;
  font-size: 11.5px;
  outline: none;
}

.quickcard-field input:focus, .quickcard-field select:focus {
  border-color: var(--accent-cyan);
}

.quickcard-actions {
  display: flex;
  gap: 8px;
  margin-top: 6px;
}

#quickcard-btn-reassign {
  background: #0284c7;
  color: #ffffff;
  border: 1px solid #38bdf8;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.15s ease-out;
}

#quickcard-btn-reassign:hover {
  background: #0369a1;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
  transform: translateY(-1px);
}

#quickcard-zone-start, #quickcard-zone-end, #quickcard-via {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
}

/* ==========================================================================
   8. PANEL INFERIOR: BITÁCORA ACTIVA DE TRABAJOS EN VÍA (DOCK OCIR)
   ========================================================================== */
#bottom-dock {
  height: 220px;
  background: var(--bg-panel);
  border-top: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  z-index: 95;
  box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.5);
}

.dock-header {
  height: 38px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0d1626;
  border-bottom: 1px solid var(--border-subtle);
}

.dock-tabs {
  display: flex;
  gap: 16px;
}

.dock-tab {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--text-muted);
  cursor: pointer;
  padding: 8px 4px;
  border-bottom: 2px solid transparent;
  transition: all 0.2s;
  letter-spacing: 0.8px;
}

.dock-tab:hover {
  color: #fff;
}

.dock-tab.active {
  color: var(--accent-cyan);
  border-bottom-color: var(--accent-cyan);
}

.dock-counter-badge {
  background: #1e2c44;
  color: #94a3b8;
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 10px;
  margin-left: 6px;
}

.dock-tab.active .dock-counter-badge {
  background: #0284c7;
  color: #e0f2fe;
}

.dock-search-box {
  display: flex;
  align-items: center;
  background: #0a111e;
  border: 1px solid var(--border-subtle);
  border-radius: 4px;
  padding: 3px 8px;
  gap: 6px;
}

.dock-search-box input {
  background: transparent;
  border: none;
  outline: none;
  color: #fff;
  font-size: 11px;
  width: 170px;
}

.dock-content {
  flex: 1;
  overflow-y: auto;
  padding: 8px 16px;
}

/* Tabla de Trabajos */
.work-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
  text-align: left;
}

.work-table th {
  background: #09101b;
  color: #94a3b8;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  padding: 8px 10px;
  border-bottom: 1px solid var(--border-subtle);
  position: sticky;
  top: 0;
  z-index: 2;
}

.work-table td {
  padding: 8px 10px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  color: #cbd5e1;
  vertical-align: middle;
}

.work-table tr {
  transition: background 0.15s;
}

.work-table tr:hover td {
  background: rgba(56, 189, 248, 0.04);
}

.tag-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 7px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 700;
}

.tag-crew {
  background: rgba(245, 158, 11, 0.18);
  color: #fbbf24;
  border: 1px solid rgba(245, 158, 11, 0.4);
}

.tag-vehicle {
  background: rgba(56, 189, 248, 0.18);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.4);
}

.tag-via-1 {
  background: #064e3b;
  color: #a7f3d0;
}

.tag-via-2 {
  background: #1e3a8a;
  color: #bfdbfe;
}

.btn-table-action {
  padding: 4px 8px;
  font-size: 10px;
  border-radius: 3px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  color: #e2e8f0;
  cursor: pointer;
  transition: all 0.15s var(--ease-out);
}

.btn-table-action:hover {
  background: var(--bg-elevated);
  border-color: var(--accent-cyan);
}

.btn-table-action:active {
  transform: scale(0.95);
}

.btn-table-action.danger:hover {
  background: #991b1b;
  border-color: #ef4444;
}

/* ==========================================================================
   9. MODALES Y TOASTS
   ========================================================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(4, 9, 16, 0.78);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s var(--ease-out);
}

.modal-overlay.active {
  opacity: 1;
  pointer-events: all;
}

.modal-window {
  width: 90%;
  max-width: 560px;
  background: var(--bg-panel);
  border: 1px solid var(--border-accent);
  border-radius: 8px;
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.8), var(--shadow-glow-cyan);
  overflow: hidden;
  transform: scale(0.95);
  transition: transform 0.22s var(--ease-elastic);
}

.modal-overlay.active .modal-window {
  transform: scale(1);
}

.modal-header {
  padding: 14px 20px;
  background: #0a121e;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-header h3 {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.modal-close-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 18px;
  cursor: pointer;
  padding: 4px;
}

.modal-close-btn:hover {
  color: #fff;
}

.modal-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-height: 70vh;
  overflow-y: auto;
}

.modal-footer {
  padding: 12px 20px;
  background: #0a121e;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* Ficha Ejecutiva Jefatura */
.pitch-hero-card {
  background: linear-gradient(135deg, #10253d 0%, #0a1626 100%);
  border: 1px solid #38bdf8;
  border-radius: 6px;
  padding: 16px;
  margin-bottom: 12px;
}

.pitch-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 14px;
}

.pitch-box {
  background: #0c1422;
  border: 1px solid var(--border-subtle);
  border-radius: 6px;
  padding: 12px;
}

.pitch-box h4 {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.pitch-box ul {
  padding-left: 18px;
  font-size: 11px;
  color: #cbd5e1;
  line-height: 1.5;
}

/* Toast Notifications */
#toast-container {
  position: fixed;
  bottom: 240px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 7000;
  pointer-events: none;
}

.toast {
  background: #111d2e;
  border: 1px solid var(--accent-cyan);
  color: #fff;
  padding: 10px 18px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.7);
  opacity: 0;
  transform: translateY(10px);
  animation: toastIn 0.25s var(--ease-out) forwards;
}

@keyframes toastIn {
  to { opacity: 1; transform: translateY(0); }
}

@keyframes toastOut {
  to { opacity: 0; transform: translateY(-10px); }
}

/* ==========================================================================
   10. ESTILOS DE EDICIÓN RÁPIDA, ANIMACIONES GAME-FEEL Y PARTE DIARIO SPCO
   ========================================================================== */

/* Filas combinadas en Quickcard */
.quickcard-row {
  display: flex;
  gap: 8px;
}

.quickcard-actions .btn-save-action {
  background: #0284c7;
  color: #ffffff;
  font-weight: bold;
}

.quickcard-actions .btn-save-action:hover {
  background: #0369a1;
}

.quickcard-actions .btn-finish-action {
  background: #10b981;
  color: #ffffff;
  font-weight: bold;
}

.quickcard-actions .btn-finish-action:hover {
  background: #059669;
}

/* Pestaña de Trabajos Terminados */
.dock-counter-badge.completed-badge {
  background: #065f46;
  color: #a7f3d0;
  border: 1px solid #10b981;
}

.dock-tab.active .dock-counter-badge.completed-badge {
  background: #10b981;
  color: #064e3b;
  font-weight: 800;
}

.tag-completed {
  background: rgba(16, 185, 129, 0.16);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.35);
}

/* Botón Parte Diario en Header */
.action-btn.btn-sheet {
  background: linear-gradient(135deg, #1e3a5f 0%, #152842 100%);
  border-color: #38bdf8;
  color: #e0f2fe;
}

.action-btn.btn-sheet:hover {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #ffffff;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
}

/* Animaciones y Gestos de Trabajo (Game-Feel) */
.crew-flashlight-beam {
  animation: flashlightSweep 2.2s infinite alternate ease-in-out;
  transform-origin: 0px 0px;
}

@keyframes flashlightSweep {
  0% { opacity: 0.25; transform: rotate(-5deg); }
  50% { opacity: 0.55; transform: rotate(4deg); }
  100% { opacity: 0.35; transform: rotate(-2deg); }
}

.crew-work-sparks {
  animation: sparkPulse 0.9s infinite alternate ease-in-out;
}

@keyframes sparkPulse {
  0% { opacity: 0.1; transform: scale(0.8); }
  50% { opacity: 0.95; transform: scale(1.15); filter: drop-shadow(0 0 4px #fde68a); }
  100% { opacity: 0.3; transform: scale(0.9); }
}

.vehicle-work-indicator {
  animation: vehIndicatorGlow 1.2s infinite alternate ease-in-out;
}

@keyframes vehIndicatorGlow {
  0% { opacity: 0.4; }
  100% { opacity: 1; filter: drop-shadow(0 0 6px #38bdf8); }
}

/* ==========================================================================
   11. HOJA OFICIAL Y PARTE DIARIO IMPRIMIBLE (FIRMA SPCO Y OPERADOR)
   ========================================================================== */
.sheet-modal-window {
  width: 95%;
  max-width: 960px;
}

.sheet-preview-actions-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0 12px 0;
  border-bottom: 1px solid #1e293b;
  margin-bottom: 12px;
}

/* Hoja Formal A4 (Papel Blanco de Alta Resolución) */
.printable-sheet-paper {
  background: #ffffff !important;
  color: #0f172a !important;
  padding: 26px 32px;
  border-radius: 6px;
  box-shadow: 0 6px 30px rgba(0, 0, 0, 0.45);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  line-height: 1.35;
}

.official-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2.5px solid #0284c7;
  padding-bottom: 12px;
  margin-bottom: 14px;
}

.official-logo-box {
  display: flex;
  align-items: center;
  gap: 10px;
}

.official-logo-badge {
  background: #0284c7;
  color: #ffffff;
  font-size: 16px;
  font-weight: 900;
  padding: 6px 12px;
  border-radius: 6px;
  letter-spacing: 1px;
}

.official-title-box h2 {
  font-size: 15px;
  font-weight: 900;
  color: #0f172a;
  text-transform: uppercase;
  margin: 0;
  letter-spacing: 0.5px;
}

.official-title-box p {
  font-size: 10.5px;
  color: #475569;
  font-weight: 600;
  margin: 2px 0 0 0;
}

.official-meta-box {
  text-align: right;
  font-size: 11px;
  color: #334155;
}

.official-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  background: #f1f5f9;
  padding: 10px 14px;
  border-radius: 5px;
  border: 1px solid #cbd5e1;
  margin-bottom: 16px;
  font-size: 11px;
}

.official-meta-item label {
  display: block;
  font-size: 9px;
  text-transform: uppercase;
  font-weight: 800;
  color: #64748b;
}

.official-meta-item strong {
  color: #0f172a;
  font-size: 12px;
}

.sheet-section-title {
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  color: #0369a1;
  border-left: 3.5px solid #0284c7;
  padding-left: 8px;
  margin: 14px 0 8px 0;
}

/* Tabla del Parte Diario */
.sheet-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10px;
  margin-bottom: 14px;
}

.sheet-table th {
  background: #0f172a;
  color: #ffffff;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 6px 8px;
  border: 1px solid #334155;
  text-align: left;
}

.sheet-table td {
  padding: 6px 8px;
  border: 1px solid #cbd5e1;
  color: #1e293b;
  vertical-align: middle;
}

.sheet-table tr:nth-child(even) td {
  background: #f8fafc;
}

.sheet-badge {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 3px;
  font-weight: 800;
  font-size: 9px;
}

.sheet-badge-v1 {
  background: #dcfce7;
  color: #15803d;
}

.sheet-badge-v2 {
  background: #dbeafe;
  color: #1d4ed8;
}

.sheet-badge-crew {
  background: #fef3c7;
  color: #b45309;
}

.sheet-badge-veh {
  background: #e0f2fe;
  color: #0369a1;
}

/* Cuadros de Firma Manuscrita para SPCO y Operador */
.sheet-signatures-box {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin-top: 24px;
  padding-top: 14px;
  border-top: 1.5px solid #cbd5e1;
}

.signature-card {
  border: 1.5px dashed #94a3b8;
  border-radius: 6px;
  padding: 12px 16px;
  background: #fafafa;
}

.signature-card h4 {
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  color: #0f172a;
  text-align: center;
  margin-bottom: 18px;
  letter-spacing: 0.5px;
}

.sig-field-line {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  margin-bottom: 12px;
  font-size: 10.5px;
  color: #334155;
}

.sig-field-line span {
  font-weight: 700;
  white-space: nowrap;
}

.sig-field-line .handwrite-line {
  flex: 1;
  border-bottom: 1px solid #475569;
  height: 14px;
}

/* ==========================================================================
   12. REGLAS DE IMPRESIÓN OFICIAL (@MEDIA PRINT)
   ========================================================================== */
@media print {
  body {
    background: #ffffff !important;
    color: #000000 !important;
    overflow: visible !important;
    height: auto !important;
  }

  /* Ocultar elementos de la interfaz de control en pantalla */
  #sys-header,
  #station-quicknav,
  #monopoly-toolbar,
  #main-viewport,
  #bottom-dock,
  #toast-container,
  #multicrew-popover,
  .modal-overlay:not(#modal-daily-sheet),
  .modal-header,
  .modal-footer,
  .sheet-preview-actions-bar {
    display: none !important;
  }

  #modal-daily-sheet {
    position: static !important;
    background: transparent !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    padding: 0 !important;
  }

  .sheet-modal-window {
    box-shadow: none !important;
    border: none !important;
    width: 100% !important;
    max-width: 100% !important;
    background: #ffffff !important;
    transform: none !important;
  }

  .modal-body {
    padding: 0 !important;
    max-height: none !important;
    overflow: visible !important;
  }

  .printable-sheet-paper {
    box-shadow: none !important;
    border: none !important;
    padding: 0 !important;
    color: #000000 !important;
  }

  .sheet-table th {
    background: #1e293b !important;
    color: #ffffff !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .sheet-table td {
    color: #000000 !important;
    border: 1px solid #94a3b8 !important;
  }

  .signature-card {
    border: 1px solid #000000 !important;
    background: #ffffff !important;
  }
}

/* ==========================================================================
   13. ESTILOS DE VIDEOJUEGO (GAME-FEEL), ZONA SEGURA Y BARRERA DE COLISIÓN
   ========================================================================== */

/* Botón y Tag de Zona Segura / Andén */
.btn-table-action.btn-safe-zone {
  background: #0d9488;
  color: #ffffff;
  font-weight: 700;
}

.btn-table-action.btn-safe-zone:hover {
  background: #0f766e;
  box-shadow: 0 0 10px rgba(13, 148, 136, 0.5);
}

.btn-table-action.btn-safe-zone.active-safe {
  background: #10b981;
  color: #064e3b;
  border-color: #34d399;
}

.tag-safezone {
  background: rgba(13, 148, 136, 0.25) !important;
  color: #2dd4bf !important;
  border: 1px solid #14b8a6 !important;
}

/* Barrera Láser de Peligro / Cruce Prohibido en Vía (Videojuego) */
.hazard-laser-barrier {
  stroke: #ef4444;
  stroke-width: 3.5px;
  stroke-dasharray: 8 6;
  animation: laserStrobe 0.25s infinite alternate ease-in-out;
}

@keyframes laserStrobe {
  0% { opacity: 0.4; filter: drop-shadow(0 0 4px #ef4444); }
  100% { opacity: 1; filter: drop-shadow(0 0 16px #ef4444); }
}

/* Ruedas giratorias de acero del vehículo auxiliar */
.veh-wheel-spoke {
  transform-origin: center;
  animation: wheelRotate 0.4s linear infinite;
}

@keyframes wheelRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Humo de escape diesel animado (Aros que ascienden y se disipan) */
.veh-smoke-ring-1 {
  animation: smokeRingFloat 1.4s infinite ease-out;
  transform-origin: center;
}

.veh-smoke-ring-2 {
  animation: smokeRingFloat 1.4s infinite ease-out 0.45s;
  transform-origin: center;
}

.veh-smoke-ring-3 {
  animation: smokeRingFloat 1.4s infinite ease-out 0.9s;
  transform-origin: center;
}

@keyframes smokeRingFloat {
  0% { opacity: 0.85; transform: translate(0, 0) scale(0.6); }
  40% { opacity: 0.55; transform: translate(-6px, -10px) scale(1.1); }
  80% { opacity: 0.25; transform: translate(-14px, -18px) scale(1.6); }
  100% { opacity: 0; transform: translate(-22px, -24px) scale(2.2); }
}

/* Tapa basculante del tubo de escape (Flapper de chimenea) */
.veh-exhaust-flapper {
  transform-origin: 0px 0px;
  animation: flapperBounce 0.25s infinite alternate ease-in-out;
}

@keyframes flapperBounce {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-28deg); }
}

/* Vibración y Cabeceo de Suspensión de Dresina Bivial (Chug-Chug) */
.veh-chug-vibe {
  animation: vehChugVibe 0.18s infinite alternate ease-in-out;
  transform-origin: center bottom;
}

@keyframes vehChugVibe {
  0% { transform: translateY(0); }
  100% { transform: translateY(-0.8px); }
}

/* Grúa Hidráulica Articulada con Canastilla de Catenaria */
.veh-crane-arm {
  transform-origin: 0px 0px;
  animation: craneHydraulic 2.4s infinite alternate ease-in-out;
}

@keyframes craneHydraulic {
  0% { transform: rotate(0deg); }
  50% { transform: rotate(-3.5deg); }
  100% { transform: rotate(2deg); }
}

.veh-crane-bucket {
  transform-origin: center top;
  animation: bucketSway 1.8s infinite alternate ease-in-out;
}

@keyframes bucketSway {
  0% { transform: rotate(-4deg); }
  100% { transform: rotate(4deg); }
}

/* Balizas Estroboscópicas Duales en Techo de Cabina */
.beacon-strobe-a {
  animation: strobeFlashA 0.3s infinite alternate ease-in-out;
}

.beacon-strobe-b {
  animation: strobeFlashB 0.3s infinite alternate ease-in-out;
}

@keyframes strobeFlashA {
  0%, 40% { opacity: 1; filter: drop-shadow(0 0 10px #f59e0b) brightness(1.5); }
  60%, 100% { opacity: 0.15; filter: none; }
}

@keyframes strobeFlashB {
  0%, 40% { opacity: 0.15; filter: none; }
  60%, 100% { opacity: 1; filter: drop-shadow(0 0 10px #f59e0b) brightness(1.5); }
}

/* ==========================================================================
   ESTILOS DE CUADRILLA A PIE (SPRITE DE VIDEOJUEGO ARCADE)
   ========================================================================== */

/* Ciclo de Marcha y Bobbing Elástico */
.crew-char-body {
  transform-origin: center bottom;
}

/* Pasos de piernas articuladas con rodilleras y botas */
.crew-leg-left {
  transform-origin: -4px 8px;
  animation: legStepLeft 0.38s infinite alternate ease-in-out;
}

.crew-leg-right {
  transform-origin: 4px 8px;
  animation: legStepRight 0.38s infinite alternate ease-in-out;
}

@keyframes legStepLeft {
  0% { transform: rotate(-24deg); }
  100% { transform: rotate(24deg); }
}

@keyframes legStepRight {
  0% { transform: rotate(24deg); }
  100% { transform: rotate(-24deg); }
}

/* LED de Transmisión TETRA en el hombro */
.crew-walkie-led {
  animation: walkieBlink 0.8s infinite ease-in-out;
}

@keyframes walkieBlink {
  0%, 100% { fill: #22c55e; filter: drop-shadow(0 0 4px #22c55e); }
  50% { fill: #15803d; filter: none; }
}

/* Herramienta percutora / Bateadora de riel en faena */
.crew-tamper-tool {
  transform-origin: 0px -5px;
  animation: tamperPercuss 0.12s infinite ease-in-out;
}

@keyframes tamperPercuss {
  0% { transform: translate(0, 0) rotate(0deg); }
  50% { transform: translate(1px, 2px) rotate(4deg); }
  100% { transform: translate(-0.5px, -1px) rotate(-2deg); }
}

/* Estrellas y Chispas de Trabajo sobre el Riel */
.crew-work-sparks {
  animation: sparksExplode 0.5s infinite alternate ease-in-out;
}

@keyframes sparksExplode {
  0% { opacity: 0.2; transform: scale(0.7) rotate(0deg); }
  50% { opacity: 1; transform: scale(1.25) rotate(15deg); filter: drop-shadow(0 0 6px #facc15); }
  100% { opacity: 0.4; transform: scale(0.9) rotate(-10deg); }
}

/* Compañero Asistente de Cuadrilla (Segundo Operario) */
.crew-companion-group {
  animation: companionBob 0.6s infinite alternate ease-in-out;
  transform-origin: center bottom;
}

@keyframes companionBob {
  0% { transform: translateY(0); }
  100% { transform: translateY(-1.2px); }
}

/* Banderín Rojo de Vía del Asistente */
.companion-flag {
  transform-origin: 0px 0px;
  animation: flagWave 0.5s infinite alternate ease-in-out;
}

@keyframes flagWave {
  0% { transform: rotate(-6deg); }
  100% { transform: rotate(8deg); }
}

/* Conos de Seguridad Reflectivos en Vía */
.safety-cone {
  animation: conePop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform-origin: center bottom;
}

@keyframes conePop {
  0% { transform: scale(0); opacity: 0; }
  80% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* ==========================================================================
   14. SISTEMA DE CATENARIA Y ENERGÍA 1500V DC (10 ZONAS OFICIALES LÍNEA 2)
   ========================================================================== */

/* Flujo de corriente de tracción 1500V DC que parecía energía (Línea animada) */
.track-power-flow {
  stroke: rgba(56, 189, 248, 0.75);
  stroke-width: 2.5px;
  stroke-dasharray: 12 30;
  animation: powerPulse 2.2s linear infinite;
  cursor: pointer;
  pointer-events: stroke;
  transition: stroke 0.25s, opacity 0.25s;
}

.track-power-flow:hover {
  stroke: #7dd3fc;
  filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.9));
}

@keyframes powerPulse {
  from { stroke-dashoffset: 0; }
  to { stroke-dashoffset: -168px; }
}

/* Zona de Catenaria con Corte de Tensión (0V - Desenergizado) */
.track-power-flow.catenary-cut {
  stroke: #475569 !important;
  stroke-dasharray: 5 6 !important;
  opacity: 0.4 !important;
  animation: none !important;
}

.track-power-flow.catenary-cut:hover {
  stroke: #ef4444 !important;
  opacity: 0.85 !important;
}

/* Cartela de corte de tensión 1500V */
.catenary-cut-badge {
  pointer-events: none;
}

/* Botón de Catenaria en Barra de Herramientas */
.action-btn.btn-catenary {
  background: linear-gradient(135deg, #132742 0%, #0d1a2d 100%);
  border-color: #38bdf8;
  color: #38bdf8;
}

.action-btn.btn-catenary:hover {
  background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
  color: #ffffff;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
}

.action-btn.btn-catenary.catenary-warning {
  background: linear-gradient(135deg, #3d2410 0%, #261608 100%);
  border-color: #f59e0b;
  color: #fbbf24;
}

.action-btn.btn-catenary.catenary-danger {
  background: linear-gradient(135deg, #3b1010 0%, #260a0a 100%);
  border-color: #ef4444;
  color: #fca5a5;
}

/* Modal de Control de Catenaria */
.catenary-modal-window {
  max-width: 720px;
}

.catenary-global-actions {
  display: flex;
  gap: 10px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.btn-power-on {
  background: #065f46;
  color: #a7f3d0;
  border-color: #10b981;
}

.btn-power-on:hover {
  background: #047857;
  color: #ffffff;
  box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
}

.btn-power-off {
  background: #7f1d1d;
  color: #fecaca;
  border-color: #ef4444;
}

.btn-power-off:hover {
  background: #991b1b;
  color: #ffffff;
  box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
}

.btn-power-toggle-mode {
  background: #1e3a5f;
  color: #bae6fd;
  border-color: #38bdf8;
}

.btn-power-toggle-mode.active {
  background: #0284c7;
  color: #ffffff;
  border-color: #7dd3fc;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
}

.catenary-sector-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  max-height: 400px;
  overflow-y: auto;
  padding-right: 4px;
}

.catenary-sector-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0a1322;
  border: 1px solid #1e3352;
  border-radius: 5px;
  padding: 8px 12px;
  transition: all 0.15s;
}

.catenary-sector-card.deenergized {
  border-color: #ef4444;
  background: rgba(239, 68, 68, 0.08);
}

.sector-info {
  display: flex;
  flex-direction: column;
}

.sector-title {
  font-size: 11px;
  font-weight: 700;
  color: #e2e8f0;
}

.sector-status {
  font-size: 9.5px;
  font-family: monospace;
  color: #10b981;
  font-weight: bold;
}

.catenary-sector-card.deenergized .sector-status {
  color: #ef4444;
}

.sector-toggle-btn {
  padding: 4px 9px;
  font-size: 9.5px;
  font-weight: 700;
  border-radius: 4px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.15s;
}

.sector-toggle-btn.btn-cut {
  background: #1e293b;
  color: #ef4444;
  border-color: #ef4444;
}

.sector-toggle-btn.btn-cut:hover {
  background: #ef4444;
  color: #ffffff;
}

.sector-toggle-btn.btn-restore {
  background: #064e3b;
  color: #34d399;
  border-color: #10b981;
}

.sector-toggle-btn.btn-restore:hover {
  background: #10b981;
  color: #ffffff;
}

/* Fix Badge Multicuadrilla: cero parpadeo y cero jitter */
.multicrew-badge {
  cursor: pointer;
}

.multicrew-badge:hover rect {
  fill: #0369a1;
  stroke: #7dd3fc;
}

/* Estaciones: Puertas de Andén (PSD) con LEDs sutiles */
.psd-led-blink {
  animation: psdGlow 2.5s infinite alternate ease-in-out;
}

@keyframes psdGlow {
  0%, 100% { fill: #10b981; opacity: 0.85; }
  50% { fill: #34d399; opacity: 1; }
}

/* Patio Taller Santa Anita (PTSA) */
.ptsa-tower-beacon {
  animation: beaconTowerFlash 0.7s infinite alternate ease-in-out;
}

@keyframes beaconTowerFlash {
  0% { fill: #7f1d1d; opacity: 0.3; }
  100% { fill: #ef4444; opacity: 1; filter: drop-shadow(0 0 8px #ef4444); }
}
