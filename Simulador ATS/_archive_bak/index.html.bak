    <!-- Controles Flotantes de Paneo y Zoom -->
    <div id="viewport-controls">
      <button class="vp-control-btn" id="btn-zoom-in" title="Acercar plano">+</button>
      <button class="vp-control-btn" id="btn-zoom-out" title="Alejar plano">−</button>
      <button class="vp-control-btn" id="btn-zoom-reset" title="Restablecer tamaño (100%)">1:1</button>
      <button class="vp-control-btn" id="btn-zoom-fit" title="Ajustar toda la línea a la pantalla">⛶</button>
    </div>

    <!-- Avatar Fantasma Flotante Pegman durante Drag & Drop -->
    <div id="pegman-drag-ghost">
      <div class="ghost-inner" id="ghost-emoji">👷</div>
      <div class="ghost-via-badge via-v2" id="ghost-via-badge">VÍA 2 ◄ (CALLAO)</div>
    </div>

    <!-- BANNER FLOTANTE DE SEGURIDAD: ¡PROHIBIDO! (INCOMPATIBILIDAD VEHÍCULO Y CUADRILLA) -->
    <div id="prohibition-hud">
      <div class="prohibition-title">
        <span>🚫</span> ¡PROHIBIDO! RIESGO DE COLISIÓN
      </div>
      <div class="prohibition-desc" id="prohibition-text">
        Incompatibilidad de seguridad ATS: No se permite Vehículo Auxiliar y Personal a Pie en el mismo cantón.
      </div>
    </div>

    <!-- Tarjeta Rápida Flotante para Editar Ficha Colocada (Para cuando el Operador se desocupe) -->
    <div id="token-quickcard">
      <h4 id="quickcard-title"><span>👷</span> Editar Trabajo en Vía <span style="cursor:pointer;" id="quickcard-close">✕</span></h4>
      
      <div class="quickcard-field">
        <label>Responsable / Capataz / Unidad</label>
        <input type="text" id="quickcard-resp" placeholder="Nombre del responsable">
      </div>

      <div class="quickcard-field">
        <label>Empresa / Disciplina</label>
        <select id="quickcard-company">
          <option value="Mantenimiento de Vía">Mantenimiento de Vía</option>
          <option value="Catenaria y Energía">Catenaria y Energía</option>
          <option value="Señalización ATS/CBI">Señalización ATS/CBI</option>
          <option value="Telecomunicaciones">Telecomunicaciones</option>
          <option value="Sistemas de Estación">Sistemas de Estación</option>
          <option value="Obras Civiles">Obras Civiles</option>
          <option value="Consorcio Constructor">Consorcio Constructor</option>
          <option value="Hitachi Rail STS">Hitachi Rail STS</option>
        </select>
      </div>

      <div class="quickcard-row">
        <div class="quickcard-field" style="flex:1;">
          <label>Canal Radio TETRA</label>
          <input type="text" id="quickcard-radio" placeholder="Ej. Ch-02 / Radio 304">
        </div>

        <div class="quickcard-field" id="quickcard-count-box" style="flex:1;">
          <label>N° Personas</label>
          <input type="number" id="quickcard-count" min="1" max="50">
        </div>
      </div>

      <div class="quickcard-row">
        <div class="quickcard-field" style="flex:1;">
          <label>Hora Ingreso</label>
          <input type="time" id="quickcard-timein">
        </div>
        <div class="quickcard-field" style="flex:1;">
          <label>Hora Salida</label>
          <input type="time" id="quickcard-timeout">
        </div>
      </div>

      <div class="quickcard-row">
        <div class="quickcard-field" style="flex:1;">
          <label>Vía Asignada</label>
          <select id="quickcard-via">
            <option value="V2">Vía 2 ◄ (Hacia Callao / Oeste)</option>
            <option value="V1">Vía 1 ► (Hacia Ate / Este)</option>
          </select>
        </div>
        <div class="quickcard-field" style="flex:1; justify-content:flex-end;">
          <button type="button" class="btn-table-action" id="quickcard-btn-reassign" style="background:#0284c7; color:#fff; font-weight:bold; height:32px; border-radius:4px;" title="Hacer clic o arrastrar en el plano de vía para reubicar o ampliar">
            📍 Mover en Mapa
          </button>
        </div>
      </div>

      <div class="quickcard-row">
        <div class="quickcard-field" style="flex:1;">
          <label>Cantón Desde</label>
          <select id="quickcard-zone-start"></select>
        </div>
        <div class="quickcard-field" style="flex:1;">
          <label>Cantón Hasta (Ampliación)</label>
          <select id="quickcard-zone-end"></select>
        </div>
      </div>

      <div class="quickcard-field">
        <label>Resumen de Tramos Cubiertos</label>
        <input type="text" id="quickcard-zones-desc" readonly style="color:#38bdf8; font-weight:bold;">
      </div>

      <div class="quickcard-field">
        <label>Observaciones / Detalle de Trabajo</label>
        <input type="text" id="quickcard-notes" placeholder="Ej. Inspección de vía y fijaciones">
      </div>

      <div class="quickcard-actions">
        <button class="btn-table-action btn-save-action" id="quickcard-btn-save">Guardar</button>
        <button class="btn-table-action btn-safe-zone" id="quickcard-btn-safezone" title="Mover cuadrilla a andén / zona segura para permitir paso de vehículo">🛡️ Zona Segura</button>
        <button class="btn-table-action btn-finish-action" id="quickcard-btn-finish" title="Concluir trabajo y archivar en pestaña de Terminados">✔ Concluir</button>
        <button class="btn-table-action danger" id="quickcard-btn-del" title="Despejar vía">Despejar</button>
      </div>
    </div>
  </main>

  <!-- ==========================================================================
       5. PANEL INFERIOR: BITÁCORA ACTIVA DE TRABAJOS EN VÍA (DOCK OCIR)
       ========================================================================== -->
  <footer id="bottom-dock">
    <div class="dock-header">
      <div class="dock-tabs">
        <div class="dock-tab active" data-tab="all">
          Todos los Trabajos <span class="dock-counter-badge" id="badge-tab-all">0</span>
        </div>
        <div class="dock-tab" data-tab="crews">
          Cuadrillas a Pie <span class="dock-counter-badge" id="badge-tab-crews">0</span>
        </div>
        <div class="dock-tab" data-tab="vehicles">
          Vehículos Auxiliares <span class="dock-counter-badge" id="badge-tab-vehicles">0</span>
        </div>
        <div class="dock-tab" data-tab="completed">
          Trabajos Terminados <span class="dock-counter-badge completed-badge" id="badge-tab-completed">0</span>
        </div>
      </div>

      <div style="display:flex; align-items:center; gap:12px;">
        <div class="dock-search-box">
          <span>🔍</span>
          <input type="text" id="dock-search-input" placeholder="Buscar responsable, radio, vía...">
        </div>
        <div style="font-size:11px; color:#94a3b8;">
          Haz clic en una fila para <strong style="color:#38bdf8;">centrar en mapa</strong> o editar
        </div>
      </div>
    </div>

    <div class="dock-content">
      <table class="work-table" id="work-table">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>ID / Responsable</th>
            <th>Empresa / Disciplina</th>
            <th>Vía</th>
            <th>Tramos Cubiertos</th>
            <th>Radio TETRA</th>
            <th>Personal</th>
            <th>Estado</th>
            <th>Hora Ingreso</th>
            <th>Hora Salida</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="work-table-body">
          <!-- Filas generadas dinámicamente -->
        </tbody>
      </table>
    </div>
  </footer>

    <!-- ==========================================================================
       MODAL: GESTIÓN DE CATENARIA Y ENERGÍA 1500V DC (SUBESTACIONES LÍNEA 2)
       ========================================================================== -->
  <div class="modal-overlay" id="modal-catenary">
    <div class="modal-window catenary-modal-window">
      <div class="modal-header">
        <h3><span>⚡</span> Control de Tensión de Catenaria (1500V DC) — Línea 2</h3>
        <button class="modal-close-btn" data-close="modal-catenary">✕</button>
      </div>

      <div class="modal-body">
        <p style="font-size:11.5px; color:#94a3b8; line-height:1.5;">
          Supervisión de subestaciones de tracción (SET) y alimentación 1500V DC. Puedes energizar toda la vía, aplicar corte general preventivo para mantenimiento, o alternar corte cantón por cantón.
        </p>

        <div class="catenary-global-actions">
          <button type="button" class="action-btn btn-power-on" id="btn-catenary-all-on">
            <span>⚡</span> Energizar Toda la Vía (1500V Activo)
          </button>
          <button type="button" class="action-btn btn-power-off" id="btn-catenary-all-off">
            <span>⛔</span> Desenergizar Toda la Vía (Corte General 0V)
          </button>
          <button type="button" class="action-btn btn-power-toggle-mode" id="btn-catenary-toggle-mode">
            <span>🔌</span> Modo Selector: Clic en Vía para Cortar
          </button>
        </div>

        <h4 style="font-size:11px; text-transform:uppercase; color:#38bdf8; letter-spacing:0.8px; margin:4px 0 8px 0;">
          Estado de Tensión por Cantones de Tracción (Etapa 1A):
        </h4>
        <div class="catenary-sector-grid" id="catenary-sector-grid">
          <!-- Generado dinámicamente -->
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="action-btn" data-close="modal-catenary">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       6. MODAL: REPORTE DE TURNO / RELEVO OCIR
       ========================================================================== -->
  <div class="modal-overlay" id="modal-report">
    <div class="modal-window">
      <div class="modal-header">
        <h3><span>📋</span> Acta de Control de Trabajos en Vía — Turno OCIR</h3>
        <button class="modal-close-btn" data-close="modal-report">✕</button>
      </div>

      <div class="modal-body">
        <p style="font-size:11px; color:#94a3b8; margin-bottom:8px;">
          Resumen generado automáticamente listo para imprimir o copiar al relevo de guardia entre operadores ATS / OCIR.
        </p>
        <div class="report-preview-box" id="report-content-text"></div>
      </div>

      <div class="modal-footer">
        <button type="button" class="action-btn" id="btn-copy-report">Copiar Texto</button>
        <button type="button" class="action-btn btn-primary" id="btn-print-report">Imprimir / Guardar PDF</button>
        <button type="button" class="action-btn" data-close="modal-report">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Modal Pitch Removido para interfaz limpia -->

  <!-- ==========================================================================
       8. MODAL: PARTE DIARIO OFICIAL DE TRABAJOS EN VÍA (FIRMAS SPCO Y OPERADOR)
       ========================================================================== -->
  <div class="modal-overlay" id="modal-daily-sheet">
    <div class="modal-window sheet-modal-window">
      <div class="modal-header">
        <h3><span>📝</span> Parte Diario de Control de Trabajos en Vía Principal (PCO / SPCO)</h3>
        <button class="modal-close-btn" data-close="modal-daily-sheet">✕</button>
      </div>

      <div class="modal-body">
        <div class="sheet-preview-actions-bar">
          <span style="font-size:11.5px; color:#94a3b8;">
            Documento formal listo para exportar e imprimir con casilleros para <strong>firma manuscrita</strong> del Operador de turno y Supervisor SPCO.
          </span>
          <div style="display:flex; gap:8px;">
            <button type="button" class="action-btn btn-primary" id="btn-print-daily-sheet">
              <span>🖨️</span> Imprimir / Guardar PDF
            </button>
            <button type="button" class="action-btn" id="btn-export-sheet-html">
              <span>💾</span> Descargar HTML
            </button>
          </div>
        </div>

        <!-- Contenedor Oficial del Parte Diario (Diseño blanco A4 oficial para impresión y firma a mano) -->
        <div id="printable-daily-sheet" class="printable-sheet-paper"></div>
      </div>

      <div class="modal-footer">
        <button type="button" class="action-btn" data-close="modal-daily-sheet">Cerrar</button>
      </div>
    </div>
  </div>

  <!-- Popover Flotante de Múltiples Cuadrillas Coexistiendo -->
  <div id="multicrew-popover">
    <h4><span id="popover-title">Zona Compartida</span> <span style="font-size:10px; cursor:pointer;" id="popover-close">✕</span></h4>
    <div id="popover-body"></div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container"></div>

  <!-- Script Principal del Simulador -->
  <script src="simulator.js"></script>
</body>
</html>