            <rect class="pozo-tower" x="-26" y="0" width="52" height="32" rx="4" />
            <line x1="-20" y1="6" x2="20" y2="6" stroke="#475569" stroke-width="1.2" />
            <line x1="-20" y1="10" x2="20" y2="10" stroke="#475569" stroke-width="1.2" />
